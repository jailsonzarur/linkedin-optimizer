DJANGO_SECRET_KEY=replace-with-a-generated-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Override these if 5432/6379/8000 are already taken on your machine
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=8000

DATABASE_URL=postgres://linkedin_optimizer:linkedin_optimizer@localhost:5432/linkedin_optimizer
CELERY_BROKER_URL=redis://localhost:6379/0

# Media storage: leave USE_S3 off to keep uploads on the local filesystem.
USE_S3=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
